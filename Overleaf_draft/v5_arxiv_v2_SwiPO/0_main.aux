\@writefile{toc}{\contentsline {subsection}{\numberline {F.4}GRPO (Group Relative Policy Optimization) Pipeline}{32}{subsection.F.4}\protected@file@percent }
\newlabel{sec:appendix_grpo_pipeline}{{F.4}{32}{GRPO (Group Relative Policy Optimization) Pipeline}{subsection.F.4}{}}
\newlabel{sec:appendix_grpo_pipeline@cref}{{[subappendix][4][2147483647,6]F.4}{[1][32][]32}}
\@writefile{toc}{\contentsline {paragraph}{Overview.}{32}{section*.91}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Key Innovation: No Reference Model.}{32}{section*.92}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces \textbf  {GRPO Training Pipeline.} Unlike PPO, GRPO requires \textbf  {no reference model}---advantages are computed \textbf  {group-relative} within each batch. Starting from a merged SFT checkpoint, the policy $\pi _\theta $ generates $K=6$ responses per prompt. \textbf  {Reward functions} (heuristic): (i) \texttt  {safety\_refusal} (+1.0 for refusing harmful requests), (ii) \texttt  {helpfulness} (+1.0 for substantive responses), (iii) \texttt  {format\_quality} (+0.5 for proper structure). The \textbf  {group-relative advantage} normalizes rewards within the batch: $\hat  {A}(y_i) = (R(y_i) - \mu _{\text  {batch}}) / \sigma _{\text  {batch}}$, enabling policy gradient updates without KL regularization. Output: $\pi _{\text  {GRPO\_NoInstruct}}(Y|X)$ and $\pi _{\text  {GRPO\_Instruct}}(Y|I,X)$.\relax }}{33}{figure.caption.90}\protected@file@percent }
\newlabel{fig:grpo_pipeline}{{11}{33}{\textbf {GRPO Training Pipeline.} Unlike PPO, GRPO requires \textbf {no reference model}---advantages are computed \textbf {group-relative} within each batch. Starting from a merged SFT checkpoint, the policy $\pi _\theta $ generates $K=6$ responses per prompt. \textbf {Reward functions} (heuristic): (i) \texttt {safety\_refusal} (+1.0 for refusing harmful requests), (ii) \texttt {helpfulness} (+1.0 for substantive responses), (iii) \texttt {format\_quality} (+0.5 for proper structure). The \textbf {group-relative advantage} normalizes rewards within the batch: $\hat {A}(y_i) = (R(y_i) - \mu _{\text {batch}}) / \sigma _{\text {batch}}$, enabling policy gradient updates without KL regularization. Output: $\pi _{\text {GRPO\_NoInstruct}}(Y|X)$ and $\pi _{\text {GRPO\_Instruct}}(Y|I,X)$.\relax }{figure.caption.90}{}}
\newlabel{fig:grpo_pipeline@cref}{{[figure][11][2147483647]11}{[1][32][]33}}
