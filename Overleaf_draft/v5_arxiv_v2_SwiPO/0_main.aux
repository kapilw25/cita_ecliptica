\@writefile{lof}{\contentsline {figure}{\numberline {16}{\ignorespaces \textbf  {$\beta $ sensitivity.} Reward margin peaks at $\beta \approx 0.10$--$0.12$; accuracy is stable (88--90\%), while evaluation loss increases at higher $\beta $, consistent with over-sharpening. Trial 7 ($\star $) at $\beta $=0.107 achieves strong margins while preserving switchability.\relax }}{68}{figure.caption.166}\protected@file@percent }
\newlabel{fig:hp_beta}{{16}{68}{\textbf {$\beta $ sensitivity.} Reward margin peaks at $\beta \approx 0.10$--$0.12$; accuracy is stable (88--90\%), while evaluation loss increases at higher $\beta $, consistent with over-sharpening. Trial 7 ($\star $) at $\beta $=0.107 achieves strong margins while preserving switchability.\relax }{figure.caption.166}{}}
\newlabel{fig:hp_beta@cref}{{[figure][16][2147483647]16}{[1][54][]68}}
\@writefile{lof}{\contentsline {figure}{\numberline {17}{\ignorespaces \textbf  {$\lambda _{\text  {KL}}$ sensitivity.} Reward margin exhibits an inverted-U: too low produces instability and regime interference; too high suppresses learning. Accuracy is comparatively stable, indicating the dominant effect is on switching stability rather than raw preference fit. Trial 7 ($\star $) at $\lambda _{\text  {KL}}$=0.00023 lies in the optimal band.\relax }}{69}{figure.caption.169}\protected@file@percent }
\newlabel{fig:hp_lambda}{{17}{69}{\textbf {$\lambda _{\text {KL}}$ sensitivity.} Reward margin exhibits an inverted-U: too low produces instability and regime interference; too high suppresses learning. Accuracy is comparatively stable, indicating the dominant effect is on switching stability rather than raw preference fit. Trial 7 ($\star $) at $\lambda _{\text {KL}}$=0.00023 lies in the optimal band.\relax }{figure.caption.169}{}}
\newlabel{fig:hp_lambda@cref}{{[figure][17][2147483647]17}{[1][54][]69}}
\@writefile{lof}{\contentsline {figure}{\numberline {18}{\ignorespaces \textbf  {Learning-rate sensitivity.} Reward margin is highly sensitive to LR, with an optimum near $5\times 10^{-6}$. Higher LR reduces accuracy and increases loss, especially for instruction-augmented sequences. \textbf  {Key insight:} SwiPO\_Instruct requires $\sim $50\% lower LR than standard DPO due to longer contexts and higher gradient variance.\relax }}{70}{figure.caption.173}\protected@file@percent }
\newlabel{fig:hp_lr}{{18}{70}{\textbf {Learning-rate sensitivity.} Reward margin is highly sensitive to LR, with an optimum near $5\times 10^{-6}$. Higher LR reduces accuracy and increases loss, especially for instruction-augmented sequences. \textbf {Key insight:} SwiPO\_Instruct requires $\sim $50\% lower LR than standard DPO due to longer contexts and higher gradient variance.\relax }{figure.caption.173}{}}
\newlabel{fig:hp_lr@cref}{{[figure][18][2147483647]18}{[1][54][]70}}
\@writefile{lof}{\contentsline {figure}{\numberline {19}{\ignorespaces \textbf  {Evaluation loss across policy optimization methods.} We plot evaluation loss for DPO, SwiPO, and GRPO using independent y-axes due to non-comparable loss scales. \textbf  {DPO (left):} loss $\sim $0.21--0.28 with smooth convergence; the Instruct variant is slightly lower, consistent with stronger preference fit under the instruction-augmented setup. \textbf  {SwiPO (center):} loss $\sim $0.27--0.40; the NoInstruct curve converges lower, while SwiPO\_Instruct attains larger reward margins, reflecting a separation--stability trade-off induced by the mandatory anchoring term. \textbf  {GRPO (right):} loss oscillates near zero ($\pm $0.001), characteristic of online RL training where the objective is dominated by on-policy sampling variance. \textbf  {Note:} PPO tensorboard logs were empty due to a TRL logging issue, so we do not include PPO curves here.\relax }}{70}{figure.caption.182}\protected@file@percent }
\newlabel{fig:training_loss}{{19}{70}{\textbf {Evaluation loss across policy optimization methods.} We plot evaluation loss for DPO, SwiPO, and GRPO using independent y-axes due to non-comparable loss scales. \textbf {DPO (left):} loss $\sim $0.21--0.28 with smooth convergence; the Instruct variant is slightly lower, consistent with stronger preference fit under the instruction-augmented setup. \textbf {SwiPO (center):} loss $\sim $0.27--0.40; the NoInstruct curve converges lower, while SwiPO\_Instruct attains larger reward margins, reflecting a separation--stability trade-off induced by the mandatory anchoring term. \textbf {GRPO (right):} loss oscillates near zero ($\pm $0.001), characteristic of online RL training where the objective is dominated by on-policy sampling variance. \textbf {Note:} PPO tensorboard logs were empty due to a TRL logging issue, so we do not include PPO curves here.\relax }{figure.caption.182}{}}
\newlabel{fig:training_loss@cref}{{[figure][19][2147483647]19}{[1][57][]70}}
