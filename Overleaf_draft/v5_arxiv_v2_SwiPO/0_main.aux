\newlabel{tab:ppo_vs_grpo_comparison}{{21}{35}{Key differences between the PPO and GRPO training pipelines.\relax }{table.caption.100}{}}
\newlabel{tab:ppo_vs_grpo_comparison@cref}{{[table][21][2147483647]21}{[1][34][]35}}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces \textbf  {SwiPO Training Pipeline.} SwiPO \textbf  {stacks on DPO} (not SFT) and adds a \textbf  {mandatory KL anchor} for stable multi-regime switching. \textbf  {Unified loss}: $\mathcal  {L}_{\mathrm  {SwiPO}} = \lambda _{\text  {DPO}} \cdot \mathcal  {L}_{\text  {DPO}} + \lambda _{\text  {KL}} \cdot \mathcal  {L}_{\text  {KL}}$, where $\mathcal  {L}_{\text  {KL}} = \frac  {1}{2}[\text  {mean}(\log \pi _\theta - \log \pi _{\text  {ref}})_{\text  {chosen}} + \text  {mean}(\log \pi _\theta - \log \pi _{\text  {ref}})_{\text  {rejected}}]$. \textbf  {NO $\mathcal  {L}_{\text  {SFT}}$}---adding SFT loss causes catastrophic interference on DPO-tuned models (margin collapse $2.95 \rightarrow 0.10$). \textbf  {Hyperparameter tuning}: Optuna TPE sampler with Hyperband pruner optimizes $(\lambda _{\text  {KL}}, \text  {LR}, \beta , \text  {weight\_decay}, \text  {warmup\_ratio})$ via multi-objective optimization (maximize margin, accuracy; minimize eval\_loss). \textbf  {Instruct} variant uses $\sim $50\% lower LR due to longer sequences (30--40\% more tokens). Final models use \textbf  {Trial 5} HPs (NoInstruct: margin$=$6.95) and \textbf  {Trial 7} HPs (Instruct: margin$=$7.52). Gradient clipping ($\|\nabla \| \leq 1.0$) prevents training explosion. Output: $\pi _{\text  {SwiPO\_NoInstruct}}(Y|X)$ and $\pi _{\text  {SwiPO\_Instruct}}(Y|I,X)$.\relax }}{35}{figure.caption.101}\protected@file@percent }
\newlabel{fig:cita_pipeline}{{12}{35}{\textbf {SwiPO Training Pipeline.} SwiPO \textbf {stacks on DPO} (not SFT) and adds a \textbf {mandatory KL anchor} for stable multi-regime switching. \textbf {Unified loss}: $\mathcal {L}_{\mathrm {SwiPO}} = \lambda _{\text {DPO}} \cdot \mathcal {L}_{\text {DPO}} + \lambda _{\text {KL}} \cdot \mathcal {L}_{\text {KL}}$, where $\mathcal {L}_{\text {KL}} = \frac {1}{2}[\text {mean}(\log \pi _\theta - \log \pi _{\text {ref}})_{\text {chosen}} + \text {mean}(\log \pi _\theta - \log \pi _{\text {ref}})_{\text {rejected}}]$. \textbf {NO $\mathcal {L}_{\text {SFT}}$}---adding SFT loss causes catastrophic interference on DPO-tuned models (margin collapse $2.95 \rightarrow 0.10$). \textbf {Hyperparameter tuning}: Optuna TPE sampler with Hyperband pruner optimizes $(\lambda _{\text {KL}}, \text {LR}, \beta , \text {weight\_decay}, \text {warmup\_ratio})$ via multi-objective optimization (maximize margin, accuracy; minimize eval\_loss). \textbf {Instruct} variant uses $\sim $50\% lower LR due to longer sequences (30--40\% more tokens). Final models use \textbf {Trial 5} HPs (NoInstruct: margin$=$6.95) and \textbf {Trial 7} HPs (Instruct: margin$=$7.52). Gradient clipping ($\|\nabla \| \leq 1.0$) prevents training explosion. Output: $\pi _{\text {SwiPO\_NoInstruct}}(Y|X)$ and $\pi _{\text {SwiPO\_Instruct}}(Y|I,X)$.\relax }{figure.caption.101}{}}
\newlabel{fig:cita_pipeline@cref}{{[figure][12][2147483647]12}{[1][34][]35}}
