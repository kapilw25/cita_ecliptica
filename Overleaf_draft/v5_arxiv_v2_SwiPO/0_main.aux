\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces \textbf  {Evaluation Pipeline: Metric Calculation Branches.} All 10 trained model variants (SFT, DPO, PPO, GRPO, SwiPO $\times $ NoInstruct/Instruct) share \textbf  {identical inference} (standard autoregressive generation) but differ fundamentally in \textbf  {metric calculation}. Three computational branches: (1) \textbf  {Embedding-based} (requires ML): ECLIPTICA ($M_1$) uses SentenceTransformer for cosine similarity (Fidelity $\times $ Shift); LITMUS ($M_5$) uses embeddings for cluster analysis (CHI + XB)/2. (2) \textbf  {Heuristic detection} (pattern matching): TruthfulQA ($M_2$) counts 23 uncertainty markers (HON $-$ CONF); Conditional Safety ($M_3$) counts 25 refusal indicators ($|$STRICT $-$ PERMIS$|$). (3) \textbf  {Pure counting} (arithmetic): Length Control ($M_4$) computes word count ratio (DETAIL / CONC). Output: per-model scores and instruction sensitivity ($\Delta = \text  {I} - \text  {NI}$).\relax }}{38}{figure.caption.114}\protected@file@percent }
\newlabel{fig:evaluation_pipeline}{{13}{38}{\textbf {Evaluation Pipeline: Metric Calculation Branches.} All 10 trained model variants (SFT, DPO, PPO, GRPO, SwiPO $\times $ NoInstruct/Instruct) share \textbf {identical inference} (standard autoregressive generation) but differ fundamentally in \textbf {metric calculation}. Three computational branches: (1) \textbf {Embedding-based} (requires ML): ECLIPTICA ($M_1$) uses SentenceTransformer for cosine similarity (Fidelity $\times $ Shift); LITMUS ($M_5$) uses embeddings for cluster analysis (CHI + XB)/2. (2) \textbf {Heuristic detection} (pattern matching): TruthfulQA ($M_2$) counts 23 uncertainty markers (HON $-$ CONF); Conditional Safety ($M_3$) counts 25 refusal indicators ($|$STRICT $-$ PERMIS$|$). (3) \textbf {Pure counting} (arithmetic): Length Control ($M_4$) computes word count ratio (DETAIL / CONC). Output: per-model scores and instruction sensitivity ($\Delta = \text {I} - \text {NI}$).\relax }{figure.caption.114}{}}
\newlabel{fig:evaluation_pipeline@cref}{{[figure][13][2147483647]13}{[1][37][]38}}
